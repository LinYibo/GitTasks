# Production build values, baked in by `vite build` (and by the Cloudflare
# Workers Builds pipeline, which runs the same command).
#
# The client ID is public — either commit the real value here, or set
# VITE_GITHUB_CLIENT_ID as an environment variable on the build (the
# environment takes precedence over this file).
VITE_GITHUB_CLIENT_ID=replace-me
VITE_OAUTH_PROXY_URL=https://gittasks.com/oauth
